#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    if /usr/libexec/ikuai-bypass-operations busy; then
        echo 'A single-run task is active; stop it before starting the service.' >&2
        return 1
    fi
    /usr/libexec/ikuai-bypass-operations whatsapp-sync | logger -t ikuai-bypass-addon
    procd_open_instance
    procd_set_param command /usr/libexec/ikuai-bypass-guard /etc/ikuai-bypass/config.yml
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/ikuai-bypass/config.yml
    procd_close_instance
}

stop_service() {
    /usr/libexec/ikuai-bypass-operations cancel >/dev/null 2>&1
    return 0
}

reload_service() {
    restart
}
